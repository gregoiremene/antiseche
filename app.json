{
  "expo": {
    "name": "Antisèche",
    "slug": "antiseche",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "antiseche",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B1E1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.antiseche.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B1E1E",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Antisèche accède à tes photos pour illustrer la fiche d’un élève.",
          "cameraPermission": "Antisèche accède à l’appareil photo pour prendre la photo d’un élève."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3b74d0f-b3f6-4040-993d-494c38a39610"
      }
    },
    "owner": "lisalwaspp"
  }
}
